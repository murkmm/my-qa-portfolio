---
import Footer from '../components/Footer.astro';
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; }
const { title, description, image, imageAlt } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><MainHead title={title} description={description} image={image} imageAlt={imageAlt} /></head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Nav />
      <slot />
      <Footer />
    </div>
  </body>
</html>
<style>
  .site-shell { min-height: 100vh; display: flex; flex-direction: column; }
</style>
