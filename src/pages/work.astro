---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { studioProjectMap } from '../data/projectVideos';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const studio = projects.filter((p) => p.data.studio);
const qa = projects.filter((p) => !p.data.studio);

const getCategories = (project: CollectionEntry<'work'>) => {
	const cats = new Set<string>(['all']);
	if (project.data.studio) {
		cats.add('dev');
	} else {
		cats.add('qa');
	}
	const blob = `${project.data.title} ${project.data.description} ${project.data.tags.join(' ')}`.toLowerCase();
	if (/(tool|engine|pipeline|assembly|solver|test tooling|embedded)/.test(blob)) cats.add('tools');
	if (/(mobile|android|ios)/.test(blob)) cats.add('mobile');
	if (/(multiplayer|online|co-op|party|live service)/.test(blob)) cats.add('multiplayer');

	for (const [studioKey, entry] of Object.entries(studioProjectMap)) {
		if (entry.ids.includes(project.id)) {
			cats.add(`studio:${studioKey}`);
		}
	}
	return Array.from(cats);
};

const studioLabels = Object.fromEntries(
	Object.entries(studioProjectMap).map(([key, entry]) => [key, entry.label]),
);

const grouped = projects.reduce<Record<string, CollectionEntry<'work'>[]>>((years, project) => {
	const year = String(project.data.publishDate.getUTCFullYear());
	(years[year] ||= []).push(project);
	return years;
}, {});
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));

const filterButtons = [
	{ key: 'all', label: `All (${projects.length})` },
	{ key: 'dev', label: `Games I made (${studio.length})` },
	{ key: 'qa', label: `Professional QA (${qa.length})` },
	{ key: 'tools', label: 'Tools & Technical' },
	{ key: 'multiplayer', label: 'Multiplayer' },
	{ key: 'mobile', label: 'Mobile' },
];
---

<BaseLayout
	title="Portfolio & QA Experience | Mark McManus"
	description="Explore games I've built at Ki10 Games and 10+ years of professional QA work across console, PC and mobile."
>
	<main id="main-content" tabindex="-1" class="wrapper">
		<header class="work-intro">
			<p class="mono-label">Portfolio</p>
			<h1>Games I’ve made &amp; tested</h1>
			<p>
				Everything I’ve built at Ki10 Games alongside 10+ years of QA work across AAA and indie studios. Hover
				any card with a clip tag to preview gameplay, or click in for the full write-up.
			</p>
		</header>

		<!-- Interactive Filter Bar -->
		<div class="filter-bar" role="toolbar" aria-label="Filter projects">
			<div class="filter-pills">
				{
					filterButtons.map((btn, idx) => (
						<button
							type="button"
							data-filter-btn={btn.key}
							aria-pressed={idx === 0 ? 'true' : 'false'}
							class:list={['filter-pill', { active: idx === 0 }]}
						>
							{btn.label}
						</button>
					))
				}
			</div>
			<div class="filter-meta">
				<div id="studio-chip" class="studio-chip" hidden>
					<span id="studio-chip-label"></span>
					<button type="button" id="studio-chip-clear" aria-label="Clear studio filter">&times;</button>
				</div>
				<p class="filter-count" id="filter-count" aria-live="polite">
					Showing {projects.length} projects
				</p>
			</div>
		</div>

		<!-- Development Section -->
		<section id="development" class="section" data-section="dev" aria-labelledby="development-title">
			<div class="section-heading">
				<div>
					<p class="mono-label">Ki10 Games</p>
					<h2 id="development-title">Independent development</h2>
				</div>
				<p class="section-note">Design, programming, tooling and QA on my own games.</p>
			</div>
			<div class="project-grid three-col">
				{
					studio.map((project) => (
						<div data-project-item data-cats={getCategories(project).join(',')}>
							<ProjectCard project={project} />
						</div>
					))
				}
			</div>
		</section>

		<!-- QA Credits Section -->
		<section id="qa" class="section" data-section="qa" aria-labelledby="qa-title">
			<div class="section-heading">
				<div>
					<p class="mono-label">Professional QA</p>
					<h2 id="qa-title">Studio &amp; QA credits</h2>
				</div>
				<p class="section-note">Engine tools, multiplayer, live services and multi-platform launches.</p>
			</div>
			<div class="project-grid three-col">
				{
					qa.map((project) => (
						<div data-project-item data-cats={getCategories(project).join(',')}>
							<ProjectCard project={project} />
						</div>
					))
				}
			</div>
		</section>

		<!-- Expandable Timeline -->
		<section class="timeline-section" id="timeline" aria-labelledby="timeline-title">
			<details>
				<summary>
					<span>
						<span class="mono-label">Archive by year</span>
						<span class="timeline-title" id="timeline-title">Full project timeline</span>
					</span>
					<span class="expand-label">Show / hide &darr;</span>
				</summary>
				<div class="timeline">
					<p class="timeline-note">
						Grouped by project year. My <a href="/mark-mcmanus-cv.pdf">CV (PDF)</a> has my full employment
						history.
					</p>
					{
						years.map((year) => (
							<div class="year">
								<h3>{year}</h3>
								<ul>
									{grouped[year].map((project) => (
										<li>
											<a href={`/work/${project.id}/`}>
												<span>{project.data.title}</span>
												<span class="year-role">
													{project.data.studio ? 'Development' : 'QA'} &rarr;
												</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
			</details>
		</section>
	</main>
	<ContactCTA />
</BaseLayout>

<script is:inline define:vars={{ studioLabels }}>
	(() => {
		const buttons = Array.from(document.querySelectorAll('[data-filter-btn]'));
		const items = Array.from(document.querySelectorAll('[data-project-item]'));
		const sections = Array.from(document.querySelectorAll('[data-section]'));
		const countEl = document.getElementById('filter-count');
		const studioChip = document.getElementById('studio-chip');
		const studioChipLabel = document.getElementById('studio-chip-label');
		const studioChipClear = document.getElementById('studio-chip-clear');

		const applyFilter = (key) => {
			let visible = 0;
			items.forEach((item) => {
				const cats = (item.getAttribute('data-cats') || '').split(',');
				const match = key === 'all' || cats.includes(key);
				item.hidden = !match;
				if (match) visible++;
			});

			sections.forEach((sec) => {
				const hasVisible = Array.from(sec.querySelectorAll('[data-project-item]')).some((el) => !el.hidden);
				sec.hidden = !hasVisible;
			});

			const isStudio = key.startsWith('studio:');
			buttons.forEach((btn) => {
				const active = !isStudio && btn.getAttribute('data-filter-btn') === key;
				btn.classList.toggle('active', active);
				btn.setAttribute('aria-pressed', String(active));
			});

			if (studioChip && studioChipLabel) {
				if (isStudio) {
					const sKey = key.replace('studio:', '');
					studioChipLabel.textContent = `Studio: ${studioLabels[sKey] || sKey}`;
					studioChip.hidden = false;
				} else {
					studioChip.hidden = true;
				}
			}

			if (countEl) {
				countEl.textContent = `Showing ${visible} ${visible === 1 ? 'project' : 'projects'}`;
			}
		};

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const key = btn.getAttribute('data-filter-btn') || 'all';
				applyFilter(key);
			});
		});

		studioChipClear?.addEventListener('click', () => {
			applyFilter('all');
			const url = new URL(window.location.href);
			url.searchParams.delete('studio');
			window.history.replaceState({}, '', url.pathname);
		});

		const params = new URLSearchParams(window.location.search);
		const studioParam = params.get('studio');
		const filterParam = params.get('filter');
		if (studioParam && studioLabels[studioParam]) {
			applyFilter(`studio:${studioParam}`);
		} else if (filterParam && buttons.some((b) => b.getAttribute('data-filter-btn') === filterParam)) {
			applyFilter(filterParam);
		}
	})();
</script>

<style>
	.work-intro {
		padding: 3.25rem 0 2rem;
	}
	h1 {
		font-size: clamp(2.25rem, 5vw, 3.8rem);
		margin: 0.75rem 0 1rem;
	}
	.work-intro > p:not(.mono-label) {
		max-width: 62ch;
		font-size: 1.04rem;
		line-height: 1.75;
		color: var(--muted);
	}
	.filter-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem 1rem;
		padding-block: 1.15rem;
		border-block: 1px solid var(--border);
	}
	.filter-pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.filter-pill {
		padding: 0.5rem 0.9rem;
		border-radius: 0.55rem;
		border: 1px solid var(--border-strong);
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-body);
		font-size: 0.84rem;
		font-weight: 700;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 150ms ease,
			border-color 150ms ease,
			color 150ms ease;
	}
	.filter-pill:hover {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}
	.filter-pill.active {
		background: var(--accent);
		border-color: var(--accent);
		color: #ffffff;
	}
	.filter-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.studio-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.65rem;
		border-radius: 0.5rem;
		background: var(--accent-soft);
		color: var(--accent-text);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
	}
	.studio-chip button {
		border: 0;
		background: transparent;
		color: inherit;
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
		padding: 0 0.15rem;
	}
	.filter-count {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--muted);
	}
	.section + .section {
		border-top: 1px solid var(--border);
	}
	.section-note {
		max-width: 38ch;
		font-size: 0.92rem;
		color: var(--muted);
	}
	[hidden] {
		display: none !important;
	}

	/* Timeline */
	.timeline-section {
		margin-block: 1rem 4rem;
		border-block: 1px solid var(--border);
	}
	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		cursor: pointer;
		padding: 1.5rem 0;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary > span:first-child {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.timeline-title {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--ink);
		font-family: var(--font-brand);
	}
	.expand-label {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--accent-text);
		white-space: nowrap;
	}
	.timeline-note {
		font-size: 0.9rem;
		color: var(--muted);
		padding-bottom: 1.5rem;
	}
	.year {
		display: grid;
		grid-template-columns: 90px 1fr;
		gap: 1.5rem;
		border-top: 1px solid var(--border);
		padding-block: 1.25rem;
	}
	.year h3 {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: var(--accent-text);
	}
	.year ul {
		padding: 0;
		list-style: none;
	}
	.year li + li {
		margin-top: 0.75rem;
	}
	.year li a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		color: var(--ink);
		text-decoration: none;
		font-weight: 600;
	}
	.year li a:hover {
		color: var(--accent-text);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	.year-role {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		color: var(--muted);
		white-space: nowrap;
	}
	@media (max-width: 49.99em) {
		.work-intro {
			padding-top: 2rem;
		}
		.filter-bar {
			flex-direction: column;
			align-items: stretch;
			gap: 0.75rem;
			min-width: 0;
			max-width: 100%;
		}
		.filter-pills {
			display: flex;
			flex-wrap: wrap;
			gap: 0.45rem;
			min-width: 0;
			max-width: 100%;
		}
		.filter-pill {
			padding: 0.42rem 0.72rem;
			font-size: 0.78rem;
		}
		.filter-meta {
			min-width: 0;
			max-width: 100%;
			justify-content: space-between;
		}
		.studio-chip {
			max-width: 100%;
		}
		.year {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
</style>
