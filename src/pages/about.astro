---
import ContactCTA from '../components/ContactCTA.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const skillGroups = [
	{
		title: 'QA & Testing Practice',
		items: [
			'Test planning & risk-based release sign-off',
			'Embedded Engine & Tools QA alongside engineers',
			'Exploratory, functional, performance & compliance testing',
			'Bug triage, clear repro reporting & mentoring junior testers',
			'Automated test suites & hardware-timing checks',
		],
	},
	{
		title: 'Game Development',
		items: [
			'Gameplay systems design & level pacing',
			'Godot (GDScript), Unity (C#), GBDK-2020 (C & SM83 assembly)',
			'Solver & procedural level-generation tooling (Python / Godot)',
			'Networked multiplayer & backend content pipelines',
			'Store submission, live updates & crash triage',
		],
	},
];

const techStack = [
	{ label: 'Engines', value: 'CryEngine / StarEngine · Godot · Unity · Unreal Engine 4/5 · GBDK-2020' },
	{ label: 'Languages', value: 'C# · GDScript · C · SM83 Assembly · Python' },
	{ label: 'QA & Dev Tools', value: 'Jira · TestRail · Perforce · Git · Jenkins / CI · DevTrack · Redmine' },
	{ label: 'Debugging', value: 'Log analysis · Profiling · API testing · ADB / Android Studio · Xcode · Charles / Proxyman' },
	{ label: 'Platforms', value: 'PC · PS3/PS4/PSVR/PS5 · Xbox 360/One/Series · Switch/Wii U · iOS & Android · Game Boy Color' },
];
---

<BaseLayout
	title="About Me | Mark McManus"
	description="About Mark McManus: 10+ years in games QA, Embedded QA Specialist at Cloud Imperium Games, co-founder of Ki10 Games and board member at Humans in Games."
>
	<main id="main-content" tabindex="-1" class="wrapper about-page">
		<header class="about-header">
			<p class="mono-label">About me</p>
			<h1>Testing games for 10+ years, and making my own on the side.</h1>
			<p class="about-lead">
				I’m Mark — Embedded QA Specialist on the Engine &amp; Tools teams at Cloud Imperium Games, and co-founder
				of Ki10 Games with my mate Scott.
			</p>
			<div class="header-actions">
				<a href="/mark-mcmanus-cv.pdf" class="action primary" download>
					Download CV <span class="file-type">PDF</span>
				</a>
				<a href="/work/" class="action">Browse portfolio</a>
			</div>
		</header>

		<figure class="about-photo">
			<img
				width="1553"
				height="873"
				src="/assets/Website about me image.JPG"
				alt="Mark McManus working at his laptop"
			/>
		</figure>

		<section class="about-grid">
			<h2>How I got here</h2>
			<div class="prose-col">
				<p>
					I’ve been mad about games since I was a kid, and I’ve always wanted to know how they actually work
					under the hood. That pulled me into games QA, where I’ve spent over 10 years testing titles at
					studios including TT Games, Supermassive Games, Creative Assembly and Unity.
				</p>
				<p>
					Right now I’m an <strong>Embedded QA Specialist — Tools at Cloud Imperium Games</strong>, working on
					<em>Star Citizen</em> and <em>Squadron 42</em>. I’m the main embedded QA for the Engine and Tools
					teams, testing the in-house tools, backend systems and pipelines the rest of the studio relies on
					every day.
				</p>
				<p>
					I started out on the LEGO games at TT Games and have since worked across all sorts of genres and
					platforms — from <em>Alex Kidd in Miracle World DX</em> and Supermassive’s horror games like
					<em>Man of Medan</em> to <em>Fall Guys</em> on mobile. Along the way I moved from hunting bugs into
					senior roles planning QA coverage, mentoring new testers and signing off multi-platform releases.
				</p>
				<p>
					After a decade of helping make other people’s games as polished as possible, I finally set off to
					make my own mark on the industry. In 2024 Scott and I started{' '}
					<a href="https://ki10games.com" target="_blank" rel="noopener noreferrer">Ki10 Games</a>. Since then
					we’ve released <em>Skill Check</em> (Android &amp; web) and <em>The One Bullet Job</em> (Android),
					and right now I’m building <em>Save File 0</em> for the Game Boy Color, <em>Boop n Burn</em> for
					Steam Next Fest, and rebuilding <em>KIT</em> in Godot.
				</p>
			</div>
		</section>

		<section class="about-grid">
			<h2>Industry involvement</h2>
			<div class="prose-col">
				<div class="callout-box">
					<p class="mono-label">Charity Board Member</p>
					<h3>Humans in Games</h3>
					<p>
						I sit on the board at{' '}
						<a href="https://www.humansingames.world/" target="_blank" rel="noopener noreferrer">
							Humans in Games
						</a>
						, a games industry charity, where I represent the games QA profession.
					</p>
				</div>
			</div>
		</section>

		<section class="about-grid">
			<h2>Skills &amp; tools</h2>
			<div class="prose-col">
				<div class="skills-two-col">
					{
						skillGroups.map((group) => (
							<div class="skill-card">
								<h3>{group.title}</h3>
								<ul>
									{group.items.map((item) => (
										<li>{item}</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<dl class="tech-table">
					{
						techStack.map((row) => (
							<div class="tech-row">
								<dt>{row.label}</dt>
								<dd>{row.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</section>

		<section class="about-grid">
			<h2>Outside of work</h2>
			<div class="prose-col">
				<p>
					When I’m not testing or building games, I’m usually playing them — everything from huge AAA releases
					to tiny indie experiments. Away from screens, I’m a lifelong Manchester United fan and love getting
					friends round for a good board game.
				</p>
			</div>
		</section>
	</main>

	<ContactCTA />
</BaseLayout>

<style>
	.about-page {
		padding-block: 3.25rem 4.5rem;
	}
	.about-header {
		max-width: 48rem;
	}
	h1 {
		font-size: clamp(2.25rem, 4.8vw, 3.6rem);
		margin: 0.75rem 0 1.15rem;
	}
	.about-lead {
		font-size: 1.1rem;
		line-height: 1.75;
		color: var(--muted);
	}
	.header-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.about-photo {
		margin-block: 2.75rem 3.5rem;
		overflow: hidden;
		border-radius: 1rem;
		border: 1px solid var(--border);
		box-shadow: var(--shadow-card);
	}
	.about-photo img {
		display: block;
		width: 100%;
		max-height: 520px;
		object-fit: cover;
		object-position: center 22%;
	}
	.about-grid {
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr);
		gap: 2rem 3.5rem;
		padding-block: 2.5rem;
		border-top: 1px solid var(--border);
	}
	.about-grid > h2 {
		font-size: 1.35rem;
		color: var(--ink);
	}
	.prose-col {
		max-width: 66ch;
	}
	.prose-col > p {
		font-size: 1.02rem;
		line-height: 1.82;
		color: var(--text);
	}
	.prose-col > p + p {
		margin-top: 1.1rem;
	}
	.callout-box {
		padding: 1.4rem 1.6rem;
		border-radius: 0.85rem;
		border: 1px solid var(--border);
		border-left: 3px solid var(--accent);
		background: var(--surface);
	}
	.callout-box h3 {
		font-size: 1.2rem;
		margin: 0.45rem 0 0.5rem;
	}
	.callout-box p:last-child {
		font-size: 0.96rem;
		line-height: 1.7;
		color: var(--muted);
	}
	.skills-two-col {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}
	.skill-card {
		padding: 1.4rem;
		border-radius: 0.85rem;
		border: 1px solid var(--border);
		background: var(--surface);
	}
	.skill-card h3 {
		font-size: 1.1rem;
		margin-bottom: 0.85rem;
	}
	.skill-card ul {
		padding-left: 1.1rem;
		font-size: 0.9rem;
		line-height: 1.68;
		color: var(--muted);
	}
	.skill-card li + li {
		margin-top: 0.45rem;
	}
	.tech-table {
		margin-top: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 0.85rem;
		background: var(--surface);
		overflow: hidden;
	}
	.tech-row {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 1rem;
		padding: 0.95rem 1.25rem;
		border-top: 1px solid var(--border);
	}
	.tech-row:first-child {
		border-top: 0;
	}
	.tech-row dt {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--accent-text);
		padding-top: 0.15rem;
	}
	.tech-row dd {
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--text);
	}
	@media (max-width: 54em) {
		.about-page {
			padding-top: 2.25rem;
		}
		.about-grid,
		.skills-two-col,
		.tech-row {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}
</style>
