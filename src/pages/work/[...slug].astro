---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ContactCTA from '../../components/ContactCTA.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
interface Props {
	entry: CollectionEntry<'work'>;
}
export async function getStaticPaths() {
	return (await getCollection('work')).map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title + ' | Mark McManus'} description={entry.data.description} image={entry.data.hero || entry.data.img}>
	<main id="main-content" tabindex="-1" class="wrapper case-study">
		<a class="text-link back-link" href={entry.data.studio ? '/work/#development' : '/work/#qa'}
			>← Back to {entry.data.studio ? 'development' : 'QA'} work</a
		>
		<header class="case-header">
			<div>
				<p class="eyebrow">
					{entry.data.studio ? 'Independent development' : 'Professional QA'}
					{entry.data.status && ' / ' + entry.data.status}
				</p>
				<h1>{entry.data.title}</h1>
				<p class="description">{entry.data.description}</p>
				<ul class="tags" aria-label="Skills and responsibilities">
					{entry.data.tags.map((tag) => <li>{tag}</li>)}
				</ul>
			</div>
			<div class="case-art">
				<ProjectImage
					src={entry.data.hero || entry.data.img}
					alt={entry.data.img_alt || ''}
					eager
					sizes="(min-width: 80em) 520px, (min-width: 50em) 45vw, 100vw"
				/>
			</div>
		</header>
		<div class="case-body">
			<aside class="contributions">
				<p class="eyebrow">At a glance</p>
				<h2>My part in it</h2>
				<ul>{entry.data.summary?.map((point) => <li>{point}</li>)}</ul>
				<a class="text-link" href="mailto:mcmanusmark93@outlook.com"
					>Let’s talk about it <span aria-hidden="true">↗</span></a
				>
			</aside>
			<article class="story">
				<h2>About the project</h2>
				<Content />
			</article>
		</div>
	</main>
	<ContactCTA />
</BaseLayout>
<style>
	.case-study {
		padding-block: 2.5rem 4rem;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 2.5rem;
	}
	.case-header {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		align-items: center;
		gap: 3rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--gray-800);
	}
	h1 {
		font-size: clamp(2.3rem, 4vw, 3.9rem);
		line-height: 1.08;
		letter-spacing: -0.05em;
		margin-block: 1rem 1.5rem;
	}
	.description {
		font-size: 1.05rem;
		line-height: 1.8;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding: 0;
		list-style: none;
		margin-top: 1.5rem;
	}
	.tags li {
		padding: 0.3rem 0.6rem;
		font-size: 0.7rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.3rem;
	}
	.case-art {
		aspect-ratio: 16 / 11;
		overflow: hidden;
		border-radius: 1rem;
		background: #172129;
		border: 1px solid var(--gray-800);
	}
	.case-body {
		display: grid;
		grid-template-columns: 280px minmax(0, 1fr);
		gap: 5rem;
		padding-top: 3rem;
		align-items: start;
	}
	.contributions {
		position: sticky;
		top: 2rem;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.7rem;
		background: var(--surface);
	}
	.contributions h2 {
		font-size: 1.25rem;
		margin: 0.65rem 0 1.5rem;
	}
	.contributions ul {
		padding-left: 1rem;
		font-size: 0.9rem;
		line-height: 1.75;
	}
	.contributions li + li {
		margin-top: 1rem;
	}
	.contributions .text-link {
		display: inline-block;
		margin-top: 1.5rem;
		font-size: 0.8rem;
	}
	.story {
		max-width: 68ch;
		line-height: 1.85;
		min-width: 0;
	}
	.story > h2 {
		font-size: 1.9rem;
		margin-bottom: 1.5rem;
	}
	.story :global(h3) {
		font-size: 1.4rem;
		margin-block: 2.5rem 1rem;
		letter-spacing: -0.025em;
	}
	.story :global(h4) {
		font-size: 1.2rem;
		margin-block: 2rem 1rem;
	}
	.story :global(p + p),
	.story :global(ul),
	.story :global(ol) {
		margin-top: 1rem;
	}
	.story :global(li + li) {
		margin-top: 0.6rem;
	}
	.story :global(video), .story :global(img) {
		display: block;
		border-radius: 0.7rem;
		margin-block: 1.5rem;
		width: 100%;
		height: auto;
	}
	.story :global(.screenshot-grid), .story :global(.game-screens) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}
	.story :global(.game-screens figure) {
		margin: 0;
		min-width: 0;
	}
	.story :global(.game-screens img) {
		margin-bottom: 0.6rem;
	}
	.story :global(figcaption) {
		font-size: 0.85rem;
		color: var(--gray-300);
		line-height: 1.6;
	}
	@media (max-width: 499px) {
		.story :global(.game-screens) {
			grid-template-columns: 1fr;
			max-width: 320px;
			margin-inline: auto;
		}
	}
	.story :global(a) {
		text-underline-offset: 4px;
		overflow-wrap: anywhere;
	}
	.story :global(blockquote),
	.story :global(.note) {
		margin-block: 1.5rem;
		border-left: 3px solid var(--accent-dark);
		padding: 1rem 1.5rem;
		background: var(--surface);
	}
	@media (max-width: 59.99em) {
		.case-body {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.contributions {
			position: static;
		}
	}
	@media (max-width: 49.99em) {
		.case-header {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
		.case-study {
			padding-top: 1.5rem;
		}
		.back-link {
			margin-bottom: 2rem;
		}
	}
</style>
