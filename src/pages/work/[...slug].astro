---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ContactCTA from '../../components/ContactCTA.astro';
import Lightbox from '../../components/Lightbox.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	entry: CollectionEntry<'work'>;
	previous?: CollectionEntry<'work'>;
	next?: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const all = (await getCollection('work')).sort(
		(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
	);
	return all.map((entry, idx) => ({
		params: { slug: entry.id },
		props: {
			entry,
			previous: idx < all.length - 1 ? all[idx + 1] : undefined,
			next: idx > 0 ? all[idx - 1] : undefined,
		},
	}));
}

const { entry, previous, next } = Astro.props;
const { Content } = await render(entry);
const isPixel = entry.id === 'save-file-0';
const isPositiveStatus = entry.data.status === 'Released' || entry.data.status === 'Current Role';
---

<BaseLayout
	title={entry.data.title + ' | Mark McManus'}
	description={entry.data.description}
	image={entry.data.hero || entry.data.img}
	imageAlt={entry.data.img_alt || entry.data.title}
>
	<main id="main-content" tabindex="-1" class="wrapper case-study">
		<a class="text-link back-link" href={entry.data.studio ? '/work/?filter=dev' : '/work/?filter=qa'}>
			&larr; Back to {entry.data.studio ? 'development' : 'QA'} work
		</a>

		<header class="case-header">
			<div>
				<div class="header-badges">
					<span class="mono-label">{entry.data.studio ? 'Ki10 Games · Development' : 'Professional QA'}</span>
					{
						entry.data.status && (
							<span class:list={['badge', { emerald: isPositiveStatus }]}>{entry.data.status}</span>
						)
					}
				</div>
				<h1>{entry.data.title}</h1>
				<p class="description">{entry.data.description}</p>
				<ul class="tags" aria-label="Skills and responsibilities">
					{entry.data.tags.map((tag) => <li>{tag}</li>)}
				</ul>
			</div>

			<div class:list={['case-art', { 'is-pixel': isPixel }]}>
				<ProjectImage
					src={entry.data.hero || entry.data.img}
					alt={entry.data.img_alt || entry.data.title}
					eager
					sizes="(min-width: 80em) 520px, (min-width: 50em) 45vw, 100vw"
				/>
			</div>
		</header>

		<div class="case-body">
			<aside class="contributions">
				<p class="mono-label">At a glance</p>
				<h2>My part in it</h2>
				<ul>{entry.data.summary?.map((point) => <li>{point}</li>)}</ul>
				<div class="aside-actions">
					<a class="action primary aside-btn" href="mailto:mcmanusmark93@outlook.com">Ask about this project</a>
				</div>
			</aside>

			<article class:list={['story', { 'is-pixel-story': isPixel }]}>
				<h2>Project notes</h2>
				<Content />
			</article>
		</div>

		<!-- Prev / Next Case Study Navigation -->
		{
			(previous || next) && (
				<nav class="case-nav" aria-label="More case studies">
					{previous ? (
						<a href={`/work/${previous.id}/`} class="case-nav-card">
							<span class="mono-label">&larr; Previous project</span>
							<strong>{previous.data.title}</strong>
						</a>
					) : (
						<div />
					)}
					{next && (
						<a href={`/work/${next.id}/`} class="case-nav-card next">
							<span class="mono-label">Next project &rarr;</span>
							<strong>{next.data.title}</strong>
						</a>
					)}
				</nav>
			)
		}
	</main>

	<Lightbox />
	<ContactCTA />
</BaseLayout>

<style>
	.case-study {
		padding-block: 2.25rem 4rem;
	}
	.back-link {
		margin-bottom: 2rem;
	}
	.case-header {
		display: grid;
		grid-template-columns: 1.15fr 1fr;
		align-items: center;
		gap: 3rem;
		padding-bottom: 2.75rem;
		border-bottom: 1px solid var(--border);
	}
	.header-badges {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	h1 {
		font-size: clamp(2.2rem, 4.2vw, 3.6rem);
		margin-block: 0.9rem 1.25rem;
	}
	.description {
		font-size: 1.05rem;
		line-height: 1.78;
		color: var(--text);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		padding: 0;
		list-style: none;
		margin-top: 1.4rem;
	}
	.tags li {
		padding: 0.28rem 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--muted);
		background: var(--surface-subtle);
		border: 1px solid var(--border);
		border-radius: 0.4rem;
	}
	.case-art {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 0.9rem;
		background: #0f172a;
		border: 1px solid var(--border);
		box-shadow: var(--shadow-card);
	}
	.case-art.is-pixel :global(img) {
		image-rendering: pixelated;
	}
	.case-body {
		display: grid;
		grid-template-columns: 290px minmax(0, 1fr);
		gap: 4.5rem;
		padding-top: 3rem;
		align-items: start;
	}
	.contributions {
		position: sticky;
		top: 5.5rem;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 0.9rem;
		background: var(--surface);
	}
	.contributions h2 {
		font-size: 1.25rem;
		margin: 0.5rem 0 1.2rem;
	}
	.contributions ul {
		padding-left: 1.1rem;
		font-size: 0.9rem;
		line-height: 1.7;
		color: var(--text);
	}
	.contributions li + li {
		margin-top: 0.85rem;
	}
	.aside-actions {
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
	}
	.aside-btn {
		width: 100%;
		font-size: 0.84rem;
		padding: 0.7rem 1rem;
	}
	.story {
		max-width: 68ch;
		line-height: 1.82;
		min-width: 0;
	}
	.story > h2 {
		font-size: 1.85rem;
		margin-bottom: 1.25rem;
	}
	.story :global(h3) {
		font-size: 1.38rem;
		margin-block: 2.4rem 0.9rem;
	}
	.story :global(h4) {
		font-size: 1.15rem;
		margin-block: 1.8rem 0.8rem;
	}
	.story :global(p + p),
	.story :global(ul),
	.story :global(ol) {
		margin-top: 1rem;
	}
	.story :global(li + li) {
		margin-top: 0.55rem;
	}
	.story :global(video),
	.story :global(img) {
		display: block;
		border-radius: 0.75rem;
		border: 1px solid var(--border);
		margin-block: 1.5rem;
		width: 100%;
		height: auto;
	}
	.story.is-pixel-story :global(img) {
		image-rendering: pixelated;
	}
	.story :global(video) {
		aspect-ratio: 16 / 9;
		object-fit: contain;
		background: #0b0f17;
	}
	.story :global(.screenshot-grid),
	.story :global(.game-screens) {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.15rem;
	}
	.story :global(.game-screens figure) {
		margin: 0;
		min-width: 0;
	}
	.story :global(.screenshot-grid img) {
		margin: 0;
	}
	.story :global(.game-screens img) {
		margin-bottom: 0.55rem;
	}
	.story :global(figcaption) {
		font-size: 0.85rem;
		color: var(--muted);
		line-height: 1.6;
	}
	.story :global(a) {
		text-underline-offset: 4px;
		overflow-wrap: anywhere;
		font-weight: 600;
	}
	.story :global(blockquote),
	.story :global(.note),
	.story :global(.qa-example) {
		margin-block: 1.75rem;
		border: 1px solid var(--border);
		border-left: 3px solid var(--accent);
		border-radius: 0.65rem;
		padding: 1.25rem 1.5rem;
		background: var(--surface);
	}
	.story :global(.qa-example h3) {
		margin-top: 0.5rem;
	}
	.story :global(.qa-example dt) {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		color: var(--accent-text);
		margin-top: 1.1rem;
	}
	.story :global(.qa-example dd) {
		margin: 0.35rem 0 0;
	}

	/* Prev / Next Navigation */
	.case-nav {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
	}
	.case-nav-card {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 1.25rem 1.4rem;
		border-radius: 0.85rem;
		border: 1px solid var(--border);
		background: var(--surface);
		text-decoration: none;
		transition: border-color 180ms ease, transform 180ms ease;
	}
	.case-nav-card:hover {
		border-color: var(--accent-text);
		transform: translateY(-2px);
	}
	.case-nav-card.next {
		text-align: right;
	}
	.case-nav-card strong {
		font-family: var(--font-brand);
		font-size: 1.1rem;
		color: var(--ink);
	}

	@media (max-width: 59.99em) {
		.case-body {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.contributions {
			position: static;
		}
	}
	@media (max-width: 49.99em) {
		.case-header,
		.case-nav {
			grid-template-columns: 1fr;
		}
		.case-nav-card.next {
			text-align: left;
		}
		.story :global(.screenshot-grid),
		.story :global(.game-screens) {
			grid-template-columns: 1fr;
		}
	}
</style>
