---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Mark McManus" description="404 Error — this page was not found">
	<main id="main-content" tabindex="-1" class="wrapper not-found">
		<p class="mono-label">Error 404</p>
		<h1>Page not found</h1>
		<p>That page doesn’t exist or has moved. Try heading back to the homepage or browsing the portfolio.</p>
		<div class="nf-actions">
			<a href="/" class="action primary">Back to homepage</a>
			<a href="/work/" class="action">Browse portfolio</a>
		</div>
	</main>
</BaseLayout>

<style>
	.not-found {
		padding-block: 6rem;
		text-align: center;
		max-width: 42rem;
	}
	h1 {
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		margin: 0.75rem 0 1rem;
	}
	p:not(.mono-label) {
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.75;
	}
	.nf-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
