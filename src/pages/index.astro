---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../public/assets/Website Home Image.JPG';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = await getCollection('work');
const picks = [
	{
		id: 'skill-check',
		label: 'Shipping Skill Check',
		description:
			'My first released game. I handled the design, code, backend and QA, then got it onto Android and the web.',
	},
	{
		id: 'boop-n-burn',
		label: 'Building Boop n Burn',
		description:
			'A sixteen-player party brawler. Building the shove mechanics, game systems and networked physics in Godot.',
	},
	{
		id: 'cloud-imperium-games',
		label: 'Tools QA at CIG',
		description:
			'Embedded Tools QA at Cloud Imperium Games, testing the development tools behind Star Citizen and Squadron 42.',
	},
];
const selected = picks.map((pick) => ({
	...pick,
	project: projects.find((project) => project.id === pick.id)!,
}));
---

<BaseLayout>
	<main id="main-content" tabindex="-1">
		<header class="intro wrapper">
			<div class="intro-copy">
				<p class="eyebrow">Mark McManus · Design, development & QA</p>
				<h1>Game developer.<br /><span>QA by trade.</span></h1>
				<p class="intro-description">
					I’m Mark. I make games with Scott at Ki10 Games, and test development tools at Cloud
					Imperium Games. I’ve spent over nine years in games QA.
				</p>
				<div class="actions">
					<a class="action primary" href="#selected-work"
						>Explore my work <span aria-hidden="true">↓</span></a
					>
					<a class="action" href="/mark-mcmanus-cv.pdf"
						>View CV <span class="file-type">PDF</span></a
					>
				</div>
			</div>
			<aside class="profile">
				<Image
					src={portrait}
					alt="Mark McManus"
					widths={[240, 480]}
					sizes="(min-width: 50em) 230px, 112px"
					width={240}
					height={290}
					loading="eager"
				/>
				<div class="profile-caption">
					<span class="profile-name">Mark McManus</span><span>Design, development & QA</span><a
						href="/about/">A little about me <span aria-hidden="true">↗</span></a>
				</div>
			</aside>
		</header>

		<div class="experience wrapper" aria-label="Experience">
			<p><strong>9+ years</strong><span>in games QA</span></p>
			<p><strong>Ki10 Games</strong><span>Design & development</span></p>
			<p><strong>Cloud Imperium Games</strong><span>Embedded Tools QA</span></p>
			<a href="/about/">The story so far <span aria-hidden="true">↗</span></a>
		</div>

		<section class="section wrapper" id="selected-work" aria-labelledby="selected-title">
			<div class="section-heading">
				<div>
					<p class="eyebrow">Selected work</p><h2 id="selected-title">
						A few things I’ve worked on.
					</h2>
				</div>
				<a class="text-link" href="/work/">All projects <span aria-hidden="true">↗</span></a>
			</div>
			<div class="project-grid">
				{
					selected.map(({ project, label, description }) => (
						<ProjectCard project={project} label={label} description={description} eager />
					))
				}
			</div>
		</section>

		<section class="section routes wrapper" aria-label="Explore by discipline">
			<a class="route" href="/work/#development">
				<div>
					<p class="eyebrow">Independent development</p><h2>Games I’ve made.</h2><p>
						The games we’re making at Ki10, what I’ve worked on, and what I’ve learnt along the way.
					</p><span class="text-link">Explore development <span aria-hidden="true">↗</span></span>
				</div>
			</a>
			<a class="route" href="/work/#qa">
				<div>
					<p class="eyebrow">Professional experience</p><h2>Games I’ve tested.</h2><p>
						My QA work across console, PC and mobile, from LEGO games to the tools behind Star
						Citizen.
					</p><span class="text-link">Explore QA work <span aria-hidden="true">↗</span></span>
				</div>
			</a>
		</section>

		<section class="approach wrapper" aria-labelledby="approach-title">
			<div>
				<p class="eyebrow">How I work</p><h2 id="approach-title">
					From testing games<br />to making them.
				</h2>
			</div>
			<p>
				I started in QA and spent years testing other people’s games. In 2024, Scott and I set up
				Ki10. We’ve since released Skill Check, and I’m now working on Boop n Burn alongside my job
				at CIG.
			</p>
			<a class="text-link" href="/about/"
				>More about my experience <span aria-hidden="true">↗</span></a
			>
		</section>
		<ContactCTA />
	</main>
</BaseLayout>
<style>
	.intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 230px;
		align-items: center;
		gap: 5rem;
		padding-block: 4rem 3.5rem;
	}
	h1 {
		font-size: clamp(2.7rem, 5.4vw, 4.9rem);
		line-height: 1.04;
		letter-spacing: -0.065em;
		margin: 1.25rem 0;
		font-weight: 600;
	}
	h1 span {
		color: var(--gray-400);
	}
	.intro-description {
		font-size: 1.12rem;
		line-height: 1.75;
		max-width: 55ch;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.profile {
		transform: rotate(3deg);
		padding: 0.65rem;
		border: 1px solid var(--gray-800);
		border-radius: 0.5rem;
		background: var(--surface);
		box-shadow: 0 10px 30px #00000009;
	}
	.profile img {
		border-radius: 0.25rem;
		object-fit: cover;
		width: 100%;
		aspect-ratio: 4 / 5;
		height: auto;
	}
	.profile-caption {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.8rem 0.4rem 0.35rem;
		font-size: 0.75rem;
		color: var(--gray-300);
	}
	.profile-name {
		font-weight: 700;
		color: var(--gray-0);
		font-size: 0.9rem;
	}
	.profile-caption a {
		margin-top: 0.35rem;
		text-underline-offset: 3px;
	}
	.experience {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem 3rem;
		padding-block: 1.5rem;
		border-block: 1px solid var(--gray-800);
	}
	.experience p {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		font-size: 0.78rem;
	}
	.experience strong {
		color: var(--gray-0);
		font-size: 0.95rem;
	}
	.experience a {
		margin-left: auto;
		font-size: 0.85rem;
		text-decoration: none;
	}
	.routes {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		padding-top: 0;
	}
	.route {
		display: flex;
		gap: 1.5rem;
		padding: 2rem;
		background: var(--surface);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		color: inherit;
		text-decoration: none;
	}
	.route:hover {
		border-color: var(--accent-dark);
	}
	.route-number {
		font-family: monospace;
		color: var(--accent-dark);
		font-size: 0.85rem;
	}
	.route h2 {
		font-size: 1.8rem;
		margin: 0.7rem 0 1rem;
	}
	.route p:not(.eyebrow) {
		line-height: 1.7;
		font-size: 0.95rem;
		margin-bottom: 1.5rem;
	}
	.approach {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem 4rem;
		padding-block: 0 4rem;
	}
	.approach h2 {
		font-size: clamp(1.7rem, 2.8vw, 2.4rem);
		margin-top: 1rem;
	}
	.approach > p {
		line-height: 1.8;
	}
	.approach > a {
		grid-column: 2;
	}
	@media (max-width: 49.99em) {
		.intro {
			grid-template-columns: 1fr;
			padding-block: 2.5rem 2rem;
			gap: 2rem;
		}
		.profile {
			transform: none;
			display: flex;
			gap: 1rem;
			align-items: center;
			padding: 0.6rem;
			max-width: 350px;
		}
		.profile img {
			width: 92px;
			aspect-ratio: 1;
		}
		.profile-caption {
			padding: 0;
		}
		.experience {
			gap: 1.25rem 2rem;
		}
		.experience a {
			margin-left: 0;
		}
		.routes,
		.approach {
			grid-template-columns: 1fr;
		}
		.route {
			padding: 1.5rem;
			gap: 1rem;
		}
		.approach > a {
			grid-column: 1;
		}
	}
</style>
