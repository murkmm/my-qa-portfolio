---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../../public/assets/Website Home Image.JPG';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectImage from '../components/ProjectImage.astro';
import { studioProjectMap } from '../data/projectVideos';
import '../styles/home.css';

const projects = await getCollection('work');
const studioCount = projects.filter((p) => p.data.studio).length;
const qaCount = projects.filter((p) => !p.data.studio).length;

const findWork = (id: string) => projects.find((project) => project.id === id)!;

const sf0 = findWork('save-file-0');
const cig = findWork('cloud-imperium-games');
const obj = findWork('the-one-bullet-job');
const bnb = findWork('boop-n-burn');
const fallGuys = findWork('fallguys-mobile');

const reelSlides = [
	{
		id: 'save-file-0',
		title: 'Save File 0',
		tag: 'GBC · C & SM83 ASM',
		note: '30fps raycaster running on real Game Boy Color hardware',
		video: '/videos/save-file-0-teaser.mp4',
		poster: sf0.data.hero || sf0.data.img,
		href: '/work/save-file-0/',
		pixelArt: true,
		accent: '#34d399',
	},
	{
		id: 'boop-n-burn',
		title: 'Boop n Burn',
		tag: 'GODOT · 16P BRAWLER',
		note: 'Floor-is-lava party brawler heading to Steam Next Fest',
		video: '/videos/bnb-hero.mp4',
		poster: bnb.data.hero || bnb.data.img,
		href: '/work/boop-n-burn/',
		pixelArt: false,
		accent: '#fb923c',
	},
	{
		id: 'the-one-bullet-job',
		title: 'The One Bullet Job',
		tag: 'ANDROID · 120 LEVELS',
		note: 'Turn-based heist puzzle with custom solver verification',
		video: '/videos/obj-hero.mp4',
		poster: obj.data.hero || obj.data.img,
		href: '/work/the-one-bullet-job/',
		pixelArt: false,
		accent: '#facc15',
	},
	{
		id: 'fallguys-mobile',
		title: 'Fall Guys (Mobile)',
		tag: 'UNITY · SENIOR QA',
		note: 'End-to-end iOS & Android release QA and sign-off',
		video: '/videos/fall-guys-mobile.mp4',
		poster: fallGuys.data.hero || fallGuys.data.img,
		href: '/work/fallguys-mobile/',
		pixelArt: false,
		accent: '#60a5fa',
	},
];

const rowTwoPicks = [
	{
		project: obj,
		label: 'Shipped · Android',
		description:
			'Turn-based heist puzzle with 120 solver-verified jobs, a custom Godot level generator and daily heists.',
	},
	{
		project: bnb,
		label: 'Steam Next Fest · PC',
		description:
			'16-player floor-is-lava party brawler built in Godot — short, chaotic rounds and arena hazards.',
	},
	{
		project: fallGuys,
		label: 'Senior Mobile QA · Unity',
		description:
			'Ran mobile QA from test planning to release sign-off across low- and high-end iOS and Android devices.',
	},
];

const studioLinks = Object.entries(studioProjectMap).map(([key, entry]) => ({
	key,
	label: entry.label,
	count: entry.ids.length,
}));

const craftProofs = [
	{
		metric: '30 FPS',
		title: 'On 1998 Game Boy Color hardware',
		text: 'Wrote a first-person raycaster in C and SM83 assembly for Save File 0, backed by automated ROM test suites.',
		accent: 'emerald',
	},
	{
		metric: '120 levels',
		title: 'Proven solvable by tooling',
		text: 'Built a custom level generator and solver for The One Bullet Job so every single heist is verified before shipping.',
		accent: 'emerald',
	},
	{
		metric: 'Tools QA',
		title: 'Embedded with engine teams',
		text: 'Testing internal tools, editors and pipelines supporting Star Citizen and Squadron 42 at Cloud Imperium Games.',
		accent: 'cobalt',
	},
	{
		metric: '10+ years',
		title: 'Console, PC, VR & mobile',
		text: 'From LEGO games and Supermassive horror titles to live-service mobile launches across five major studios.',
		accent: 'cobalt',
	},
];
---

<BaseLayout>
	<main id="main-content" class="home-page" tabindex="-1">
		<!-- =================================================================
		     1. HERO + INTERACTIVE LIVE BUILD REEL MONITOR
		     ================================================================= -->
		<section class="hero-band blueprint-grid">
			<div class="wrapper hero-grid">
				<div class="hero-copy">
					<p class="mono-label">Embedded Tools QA &middot; Indie Game Developer &middot; UK</p>
					<h1>Hi, I’m Mark McManus.</h1>
					<p class="hero-lead">
						I’ve spent 10+ years testing games at studios like Cloud Imperium Games, Unity, Creative
						Assembly and Supermassive Games — and now I’m building my own with my friend Scott at{' '}
						<a href="https://ki10games.com" target="_blank" rel="noopener noreferrer">Ki10 Games</a>.
					</p>

					<div class="hero-actions">
						<a class="action primary" href="#selected-work">Explore my work &darr;</a>
						<a class="action" href="/mark-mcmanus-cv.pdf" target="_blank" rel="noopener noreferrer">
							View CV <span class="file-type">PDF</span>
						</a>
						<a class="text-link about-link" href="/about/">More about me &rarr;</a>
					</div>

					<div class="profile-strip">
						<div class="avatar-ring">
							<Image
								src={portrait}
								alt="Mark McManus"
								widths={[120, 240]}
								sizes="64px"
								width={64}
								height={64}
								loading="eager"
							/>
						</div>
						<div class="profile-info">
							<div class="status-line">
								<span class="pass-dot" aria-hidden="true"></span>
								<span>Embedded QA Specialist · Cloud Imperium Games</span>
							</div>
							<p>Co-founder at Ki10 Games &middot; Board member at Humans in Games</p>
						</div>
					</div>
				</div>

				<!-- Interactive Live Build Reel Viewport -->
				<div class="reel-monitor" data-reel-stage aria-label="Interactive gameplay and QA showreel">
					<div class="monitor-chrome">
						<div class="chrome-left">
							<span class="live-dot" aria-hidden="true"></span>
							<span class="chrome-title">BUILD REEL</span>
							<span class="chrome-sep" aria-hidden="true">/</span>
							<span class="chrome-tag" data-reel-tag>{reelSlides[0].tag}</span>
						</div>
						<div class="chrome-controls">
							<span class="chrome-count" data-reel-count>01 / 04</span>
							<button type="button" class="chrome-btn" data-reel-prev aria-label="Previous clip">
								&lsaquo;
							</button>
							<button type="button" class="chrome-btn" data-reel-next aria-label="Next clip">
								&rsaquo;
							</button>
						</div>
					</div>

					<div class="monitor-screen">
						{
							reelSlides.map((slide, idx) => (
								<div
									class:list={['reel-slide', { active: idx === 0 }]}
									data-reel-slide={idx}
									aria-hidden={idx === 0 ? 'false' : 'true'}
								>
									<video
										autoplay={idx === 0}
										loop
										muted
										playsinline
										preload={idx === 0 ? 'auto' : 'metadata'}
										poster={slide.poster}
										class:list={['reel-video', { 'pixel-art': slide.pixelArt }]}
									>
										<source src={slide.video} type="video/mp4" />
									</video>
									<div class="reel-vignette" aria-hidden="true" />
									<div class="reel-caption">
										<div class="reel-caption-text">
											<strong>{slide.title}</strong>
											<span>{slide.note}</span>
										</div>
										<a href={slide.href} class="reel-link">
											Case study &rarr;
										</a>
									</div>
								</div>
							))
						}
					</div>

					<div class="monitor-tabs" role="tablist" aria-label="Choose a preview clip">
						{
							reelSlides.map((slide, idx) => (
								<button
									type="button"
									role="tab"
									aria-selected={idx === 0 ? 'true' : 'false'}
									data-reel-tab={idx}
									data-reel-tab-tag={slide.tag}
									style={`--slide-accent: ${slide.accent};`}
									class:list={['reel-tab', { active: idx === 0 }]}
								>
									<span class="reel-bar">
										<span class="reel-bar-fill" />
									</span>
									<span class="reel-tab-label">{slide.title}</span>
								</button>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- =================================================================
		     2. CLICKABLE STUDIO CREDITS & CAREER METRICS STRIP
		     ================================================================= -->
		<section class="studios-band" aria-label="Studios and experience highlights">
			<div class="wrapper studios-inner">
				<div class="stats-row">
					<div>
						<strong>10+ years</strong>
						<span>Hands-on games QA</span>
					</div>
					<div>
						<strong>{projects.length} projects</strong>
						<span>Console, PC, VR, mobile &amp; GBC</span>
					</div>
					<div>
						<strong>2 shipped games</strong>
						<span>Built &amp; released at Ki10</span>
					</div>
				</div>

				<div class="studio-list">
					<span class="mono-label">Filter by studio</span>
					<div class="studio-pills">
						{
							studioLinks.map((studio) => (
								<a href={`/work/?studio=${studio.key}`} class="studio-pill">
									<span>{studio.label}</span>
									<span class="studio-count">{studio.count}</span>
								</a>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<!-- =================================================================
		     3. ASYMMETRIC EDITORIAL BENTO SHOWCASE (WITH HOVER VIDEO)
		     ================================================================= -->
		<section class="section wrapper" id="selected-work" aria-labelledby="selected-title">
			<div class="section-heading">
				<div>
					<p class="mono-label">Selected work</p>
					<h2 id="selected-title">Flagship projects &amp; highlights</h2>
				</div>
				<a class="text-link" href="/work/">View all {projects.length} projects &rarr;</a>
			</div>

			<!-- Row 1: Flagship 7/5 Split -->
			<div class="bento-hero-row">
				<a
					href="/work/save-file-0/"
					class="bento-flagship is-sf0"
					data-hover-video-card="true"
				>
					<div class="bento-media is-pixel">
						<ProjectImage src={sf0.data.hero || sf0.data.img} alt={sf0.data.img_alt || sf0.data.title} eager />
						<video
							class="hover-video pixel-art"
							data-src="/videos/save-file-0-teaser.mp4"
							loop
							muted
							playsinline
							preload="none"
							aria-hidden="true"
						/>
						<div class="bento-scrim" aria-hidden="true"></div>
					</div>
					<div class="bento-content">
						<div class="bento-top-tags">
							<span class="bento-pill emerald">
								<span class="dot" aria-hidden="true"></span>
								Main Project · Game Boy Color
							</span>
							<span class="bento-clip-badge" aria-hidden="true">HOVER FOR CLIP</span>
						</div>
						<h3>Save File 0</h3>
						<p>
							First-person survival horror running at 30fps on real Game Boy Color hardware — written in C
							and SM83 assembly with automated ROM test suites and a physical cartridge release in the works.
						</p>
						<div class="bento-footer">
							<span class="bento-specs">C · SM83 Assembly · Automated QA</span>
							<span class="bento-cta">Read case study &rarr;</span>
						</div>
					</div>
				</a>

				<a href="/work/cloud-imperium-games/" class="bento-flagship is-cig">
					<div class="bento-media">
						<ProjectImage src={cig.data.hero || cig.data.img} alt={cig.data.img_alt || cig.data.title} eager />
						<div class="bento-scrim is-strong" aria-hidden="true"></div>
					</div>
					<div class="bento-content">
						<div class="bento-top-tags">
							<span class="bento-pill cobalt">
								<span class="dot" aria-hidden="true"></span>
								Current Role · CIG
							</span>
						</div>
						<h3>Star Citizen &amp; Squadron 42</h3>
						<p>
							Embedded QA Specialist for the Engine and Tools teams at Cloud Imperium Games — testing the
							internal tools, editors and pipelines the whole studio builds with every day.
						</p>
						<div class="bento-footer">
							<span class="bento-specs">Engine &amp; Tools QA · Pipelines</span>
							<span class="bento-cta">Read case study &rarr;</span>
						</div>
					</div>
				</a>
			</div>

			<!-- Row 2: 3-Column Hover-to-Play Trio -->
			<div class="project-grid three-col bento-row-two">
				{
					rowTwoPicks.map(({ project, label, description }) => (
						<ProjectCard project={project} label={label} description={description} />
					))
				}
			</div>
		</section>

		<!-- =================================================================
		     4. DEEP-SLATE "QA x ENGINEERING CRAFT" CONTRAST BAND
		     ================================================================= -->
		<section class="craft-band" aria-labelledby="craft-title">
			<div class="wrapper">
				<div class="craft-header">
					<div>
						<p class="craft-kicker">QA &times; Engineering</p>
						<h2 id="craft-title">Two sides of the same job.</h2>
					</div>
					<p class="craft-sub">
						A decade of breaking AAA games made me much better at building my own — and writing low-level
						code, solvers and test tools makes me a sharper QA specialist.
					</p>
				</div>

				<div class="proof-grid">
					{
						craftProofs.map((item) => (
							<article class:list={['proof-card', item.accent]}>
								<span class="proof-metric">{item.metric}</span>
								<h3>{item.title}</h3>
								<p>{item.text}</p>
							</article>
						))
					}
				</div>

				<div class="tracks-grid">
					<a class="track-card emerald" href="/work/?filter=dev">
						<div class="track-top">
							<span class="track-kicker">Independent development</span>
							<span class="track-badge emerald">{studioCount} projects</span>
						</div>
						<h3>Games I’ve made</h3>
						<p>
							From a real Game Boy Color raycaster in C and assembly to shipped Godot games on Android and
							the web — design, programming, tooling and QA at Ki10 Games.
						</p>
						<span class="track-cta">Browse development work &rarr;</span>
					</a>

					<a class="track-card cobalt" href="/work/?filter=qa">
						<div class="track-top">
							<span class="track-kicker">Professional QA</span>
							<span class="track-badge cobalt">{qaCount} credits</span>
						</div>
						<h3>Games I’ve tested</h3>
						<p>
							A decade of hands-on QA across LEGO titles, Supermassive horror games, Fall Guys on mobile,
							and internal engine &amp; tools pipelines at Cloud Imperium Games.
						</p>
						<span class="track-cta">Browse QA credits &rarr;</span>
					</a>
				</div>
			</div>
		</section>

		<!-- =================================================================
		     5. BACKGROUND + INDIE QA SERVICES & HUMANS IN GAMES
		     ================================================================= -->
		<section class="section wrapper story-grid" aria-labelledby="story-title">
			<div class="story-copy">
				<p class="mono-label">Background</p>
				<h2 id="story-title">From testing games to building my own</h2>
				<p>
					I started out testing LEGO games at TT Games and worked my way up across console, PC, VR and
					mobile before moving into Embedded Tools QA at Cloud Imperium Games. Spending 10 years spotting
					what makes games break — and what makes them feel great — eventually pushed me to start making
					my own.
				</p>
				<p>
					In 2024 my friend Scott and I started Ki10 Games. Since then we’ve released <em>Skill Check</em>
					and <em>The One Bullet Job</em>, and right now my main focus is <em>Save File 0</em> for the
					Game Boy Color alongside <em>Boop n Burn</em> for Steam Next Fest.
				</p>
				<div class="story-links">
					<a class="text-link" href="/about/">Read full background &amp; skills &rarr;</a>
				</div>
			</div>

			<aside class="qa-callout">
				<p class="mono-label">Freelance &amp; Community</p>
				<h3>Need an extra pair of eyes on an indie build?</h3>
				<p>
					Through Ki10 Games I also offer fixed-price manual QA passes for indie developers and small
					teams — clear repro steps, priority rankings, and honest feedback starting from £35.
				</p>
				<div class="callout-actions">
					<a
						class="action primary"
						href="https://ki10games.com/qa-services"
						target="_blank"
						rel="noopener noreferrer"
					>
						Ki10 QA Services <span aria-hidden="true">↗</span>
					</a>
				</div>
				<p class="charity-note">
					I also sit on the board at{' '}
					<a href="https://www.humansingames.world/" target="_blank" rel="noopener noreferrer">
						Humans in Games
					</a>
					, representing games QA.
				</p>
			</aside>
		</section>

		<ContactCTA />
	</main>
</BaseLayout>

<script is:inline>
	(() => {
		const stage = document.querySelector('[data-reel-stage]');
		if (!stage || stage.dataset.ready === 'true') return;
		stage.dataset.ready = 'true';

		const slides = Array.from(stage.querySelectorAll('[data-reel-slide]'));
		const tabs = Array.from(stage.querySelectorAll('[data-reel-tab]'));
		const countEl = stage.querySelector('[data-reel-count]');
		const tagEl = stage.querySelector('[data-reel-tag]');
		if (!slides.length) return;

		let active = 0;
		let timer = null;
		let paused = false;
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const setActive = (nextIdx) => {
			active = (nextIdx + slides.length) % slides.length;
			slides.forEach((slide, idx) => {
				const isCurrent = idx === active;
				slide.classList.toggle('active', isCurrent);
				slide.setAttribute('aria-hidden', String(!isCurrent));
				const vid = slide.querySelector('video');
				if (vid) {
					if (isCurrent && !reducedMotion) {
						vid.play().catch(() => {});
					} else {
						vid.pause();
					}
				}
			});

			tabs.forEach((tab, idx) => {
				const isCurrent = idx === active;
				tab.classList.toggle('active', isCurrent);
				tab.setAttribute('aria-selected', String(isCurrent));
				const fill = tab.querySelector('.reel-bar-fill');
				if (fill && isCurrent) {
					fill.style.animation = 'none';
					void fill.offsetWidth;
					fill.style.animation = '';
				}
				if (isCurrent && tagEl) {
					tagEl.textContent = tab.getAttribute('data-reel-tab-tag') || '';
				}
			});

			if (countEl) {
				countEl.textContent = `0${active + 1} / 0${slides.length}`;
			}
		};

		const startCycle = () => {
			if (reducedMotion) return;
			window.clearInterval(timer);
			timer = window.setInterval(() => {
				if (!paused) setActive(active + 1);
			}, 7000);
		};

		tabs.forEach((tab, idx) => {
			tab.addEventListener('click', () => {
				setActive(idx);
				startCycle();
			});
		});

		stage.querySelector('[data-reel-prev]')?.addEventListener('click', () => {
			setActive(active - 1);
			startCycle();
		});
		stage.querySelector('[data-reel-next]')?.addEventListener('click', () => {
			setActive(active + 1);
			startCycle();
		});

		stage.addEventListener('mouseenter', () => {
			paused = true;
		});
		stage.addEventListener('mouseleave', () => {
			paused = false;
		});
		stage.addEventListener('focusin', () => {
			paused = true;
		});
		stage.addEventListener('focusout', () => {
			paused = false;
		});

		let touchStartX = 0;
		let touchStartY = 0;
		stage.addEventListener(
			'touchstart',
			(e) => {
				if (e.touches.length !== 1) return;
				touchStartX = e.touches[0].clientX;
				touchStartY = e.touches[0].clientY;
			},
			{ passive: true },
		);
		stage.addEventListener(
			'touchend',
			(e) => {
				if (!e.changedTouches.length) return;
				const dx = e.changedTouches[0].clientX - touchStartX;
				const dy = e.changedTouches[0].clientY - touchStartY;
				if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) {
					setActive(dx < 0 ? active + 1 : active - 1);
					startCycle();
				}
			},
			{ passive: true },
		);

		startCycle();
	})();
</script>
