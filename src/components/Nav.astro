---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';
import ThemeToggle from './ThemeToggle.astro';

const textLinks: { label: string; href: string; external?: boolean }[] = [
	{ label: 'Home', href: '/' },
	{ label: 'Portfolio', href: '/work/' },
	{ label: 'About', href: '/about/' },
	{ label: 'Ki10 Games', href: 'https://ki10games.com', external: true },
];

const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/mark-mcmanus-b52b11105/',
		icon: 'linkedin-logo-alt',
	},
	{ label: 'GitHub', href: 'https://github.com/murkmm', icon: 'github-logo' },
];

const isCurrentPage = (href: string) => {
	if (href.startsWith('http')) return false;
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<header class="site-header">
	<nav aria-label="Main navigation" class="wrapper">
		<div class="menu-header">
			<a href="/" class="site-title">
				<span class="brand-mark" aria-hidden="true">MM</span>
				<span class="brand-text">
					<strong>Mark McManus</strong>
					<span class="brand-sub">QA · Game Dev</span>
				</span>
			</a>
			<menu-button>
				<template>
					<button
						type="button"
						class="menu-button"
						aria-expanded="false"
						aria-controls="menu-content"
					>
						<span class="sr-only">Menu</span>
						<Icon icon="list" />
					</button>
				</template>
			</menu-button>
		</div>

		<noscript>
			<ul class="nav-items">
				{
					textLinks.map(({ label, href, external }) => (
						<li>
							<a
								aria-current={isCurrentPage(href) ? 'page' : null}
								class="link"
								href={href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</noscript>

		<div id="menu-content" hidden>
			<ul class="nav-items">
				{
					textLinks.map(({ label, href, external }) => (
						<li>
							<a
								aria-current={isCurrentPage(href) ? 'page' : null}
								class="link"
								href={href}
								target={external ? '_blank' : undefined}
								rel={external ? 'noopener noreferrer' : undefined}
							>
								{label}
								{external && <span class="ext" aria-hidden="true">↗</span>}
							</a>
						</li>
					))
				}
			</ul>

			<div class="menu-footer">
				<a class="cv-pill" href="/mark-mcmanus-cv.pdf" target="_blank" rel="noopener noreferrer">
					CV <span class="file-type">PDF</span>
				</a>
				<div class="socials">
					{
						iconLinks.map(({ href, icon, label }) => (
							<a href={href} class="social" target="_blank" rel="noopener noreferrer">
								<span class="sr-only">{label}</span>
								<Icon icon={icon} />
							</a>
						))
					}
				</div>
				<div class="theme-toggle">
					<ThemeToggle />
				</div>
			</div>
		</div>
	</nav>
</header>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			menu.classList.add('menu-content');

			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			btn.addEventListener('click', () => setExpanded(menu.hidden));

			menu.addEventListener('click', (event) => {
				if (!mediaQueries.matches && (event.target as HTMLElement).closest('a')) {
					setExpanded(false);
				}
			});

			document.addEventListener('click', (event) => {
				if (
					!mediaQueries.matches &&
					!menu.hidden &&
					!this.closest('nav')!.contains(event.target as Node)
				) {
					setExpanded(false);
				}
			});

			const mediaQueries = window.matchMedia('(min-width: 52em)');
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);

			this.closest('nav')!.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && !mediaQueries.matches && !menu.hidden) {
					setExpanded(false);
					btn.focus();
				}
			});
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 60;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		position: relative;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-block: 0.9rem;
		gap: 1.5rem;
	}
	.menu-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		color: var(--ink);
		text-decoration: none;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 0.5rem;
		background: var(--accent);
		color: #ffffff;
		font-family: var(--font-brand);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}
	.brand-text strong {
		font-family: var(--font-brand);
		font-size: 0.98rem;
		font-weight: 700;
		color: var(--ink);
	}
	.brand-sub {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--muted);
	}
	.menu-button {
		border: 1px solid var(--border-strong);
		border-radius: 0.5rem;
		width: 42px;
		height: 42px;
		display: grid;
		place-items: center;
		font-size: 1.4rem;
		background: var(--surface);
		color: var(--ink);
		cursor: pointer;
	}
	.menu-button[hidden],
	[hidden] {
		display: none;
	}
	.menu-content {
		display: flex;
		align-items: center;
		gap: 1.75rem;
	}
	.menu-content[hidden] {
		display: none;
	}
	.nav-items {
		display: flex;
		align-items: center;
		padding: 0;
		gap: 0.25rem;
		list-style: none;
	}
	.link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.5rem 0.8rem;
		color: var(--muted);
		text-decoration: none;
		font-size: 0.88rem;
		font-weight: 600;
		border-radius: 0.45rem;
		transition: color 150ms ease, background-color 150ms ease;
	}
	.link:hover {
		color: var(--ink);
		background: var(--surface-subtle);
	}
	.link[aria-current='page'] {
		color: var(--accent-text);
		background: var(--accent-soft);
	}
	.ext {
		font-size: 0.78rem;
		opacity: 0.7;
	}
	.menu-footer,
	.socials {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.cv-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.75rem;
		border-radius: 0.45rem;
		border: 1px solid var(--border-strong);
		background: var(--surface);
		color: var(--ink);
		font-size: 0.8rem;
		font-weight: 700;
		text-decoration: none;
		margin-right: 0.35rem;
		transition: border-color 150ms ease, color 150ms ease;
	}
	.cv-pill:hover {
		border-color: var(--accent-text);
		color: var(--accent-text);
	}
	.social {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 0.45rem;
		color: var(--muted);
		font-size: 1.15rem;
		transition: color 150ms ease, background-color 150ms ease;
	}
	.social:hover {
		color: var(--accent-text);
		background: var(--surface-subtle);
	}
	.theme-toggle {
		display: flex;
		margin-left: 0.25rem;
	}
	@media (max-width: 51.99em) {
		nav {
			display: block;
		}
		.menu-content {
			position: absolute;
			top: calc(100% + 0.5rem);
			left: 1rem;
			right: 1rem;
			padding: 1rem;
			border: 1px solid var(--border-strong);
			border-radius: 0.85rem;
			background: var(--surface);
			box-shadow: var(--shadow-card);
		}
		.menu-content:not([hidden]) {
			display: block;
		}
		.nav-items {
			flex-direction: column;
			align-items: stretch;
		}
		.link {
			padding: 0.8rem;
		}
		.menu-footer {
			justify-content: space-between;
			margin-top: 0.75rem;
			padding-top: 0.75rem;
			border-top: 1px solid var(--border);
		}
	}
</style>
