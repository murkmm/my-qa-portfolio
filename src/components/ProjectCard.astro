---
import type { CollectionEntry } from 'astro:content';
import ProjectImage from './ProjectImage.astro';
import { projectVideos } from '../data/projectVideos';

interface Props {
	project: CollectionEntry<'work'>;
	label?: string;
	description?: string;
	eager?: boolean;
}

const { project, label, description, eager = false } = Astro.props;
const { data, id } = project;
const isPositiveStatus = data.status === 'Released' || data.status === 'Current Role';
const year = data.publishDate.getUTCFullYear();
const previewVideo = projectVideos[id];
---

<article class="project-card" data-hover-video-card={previewVideo ? 'true' : undefined}>
	<a href={`/work/${id}/`} class="project-link">
		<div class:list={['art', { 'is-pixel': id === 'save-file-0' }]}>
			<ProjectImage src={data.img} alt={data.img_alt || data.title} eager={eager} />
			{
				previewVideo && (
					<video
						class="hover-video"
						data-src={previewVideo}
						loop
						muted
						playsinline
						preload="none"
						aria-hidden="true"
					/>
				)
			}
			{
				previewVideo && (
					<span class="clip-pill" aria-hidden="true">
						<span class="play-tri"></span>
						CLIP
					</span>
				)
			}
			{
				data.status && (
					<span class:list={['status', { positive: isPositiveStatus }]}>
						<span class="dot" aria-hidden="true"></span>
						{data.status}
					</span>
				)
			}
		</div>
		<div class="copy">
			<div class="meta-row">
				<span class="mono-label">{label || (data.studio ? 'Ki10 Games' : 'Professional QA')}</span>
				<span class="year">{year}</span>
			</div>
			<h3>{data.title}</h3>
			{
				description ? (
					<p class="summary-text">{description}</p>
				) : (
					<ul class="summary">
						{data.summary?.slice(0, 2).map((point) => (
							<li>{point}</li>
						))}
					</ul>
				)
			}
			<span class="read">
				Read case study <span class="arrow" aria-hidden="true">&rarr;</span>
			</span>
		</div>
	</a>
</article>

<script is:inline>
	(() => {
		if (window.__portfolioHoverVideoInit) return;
		window.__portfolioHoverVideoInit = true;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
		if (reducedMotion || !canHover) return;

		const attachHoverVideos = () => {
			document.querySelectorAll('[data-hover-video-card]').forEach((card) => {
				if (card.dataset.videoBound === 'true') return;
				card.dataset.videoBound = 'true';

				const video = card.querySelector('video.hover-video');
				if (!video) return;

				const start = () => {
					const src = video.getAttribute('data-src');
					if (src && !video.getAttribute('src')) {
						video.setAttribute('src', src);
						video.load();
					}
					video
						.play()
						.then(() => {
							card.classList.add('is-playing');
						})
						.catch(() => {});
				};

				const stop = () => {
					card.classList.remove('is-playing');
					video.pause();
				};

				card.addEventListener('pointerenter', start);
				card.addEventListener('pointerleave', stop);
				card.addEventListener('focusin', start);
				card.addEventListener('focusout', stop);
			});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', attachHoverVideos);
		} else {
			attachHoverVideos();
		}
	})();
</script>

<style>
	.project-card {
		height: 100%;
		min-width: 0;
	}
	.project-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: var(--text);
		border: 1px solid var(--border);
		border-radius: 0.95rem;
		overflow: hidden;
		background: var(--surface);
		transition:
			border-color 200ms ease,
			transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 220ms ease;
	}
	.project-link:hover {
		border-color: var(--accent-text);
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
	}
	.art {
		aspect-ratio: 16 / 10;
		position: relative;
		overflow: hidden;
		background: #0b0f17;
	}
	.art :global(img) {
		transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}
	.project-link:hover .art :global(img) {
		transform: scale(1.04);
	}
	.art.is-pixel :global(img),
	.art.is-pixel .hover-video {
		image-rendering: pixelated;
	}
	.hover-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		pointer-events: none;
		transition: opacity 280ms ease;
	}
	.project-card.is-playing .hover-video {
		opacity: 1;
	}
	.clip-pill {
		position: absolute;
		right: 0.75rem;
		top: 0.75rem;
		display: none;
		align-items: center;
		gap: 0.35rem;
		padding: 0.24rem 0.5rem;
		border-radius: 0.38rem;
		border: 1px solid rgba(255, 255, 255, 0.22);
		background: rgba(11, 15, 23, 0.78);
		backdrop-filter: blur(6px);
		color: rgba(248, 250, 252, 0.92);
		font-family: var(--font-mono);
		font-size: 0.63rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		transition: opacity 200ms ease;
	}
	@media (hover: hover) and (pointer: fine) {
		.clip-pill {
			display: inline-flex;
		}
	}
	.project-card.is-playing .clip-pill {
		opacity: 0;
	}
	.play-tri {
		width: 0;
		height: 0;
		border-top: 4px solid transparent;
		border-bottom: 4px solid transparent;
		border-left: 6px solid #60a5fa;
	}
	.status {
		position: absolute;
		left: 0.85rem;
		bottom: 0.85rem;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.6rem;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 0.4rem;
		background: rgba(11, 15, 23, 0.86);
		backdrop-filter: blur(6px);
		color: #f8fafc;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	.status .dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #60a5fa;
	}
	.status.positive .dot {
		background: #34d399;
	}
	.copy {
		padding: 1.3rem 1.4rem 1.4rem;
		display: flex;
		flex-direction: column;
		flex: 1;
		gap: 0.65rem;
	}
	.meta-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.year {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}
	h3 {
		font-size: clamp(1.18rem, 1.8vw, 1.42rem);
		line-height: 1.2;
		color: var(--ink);
	}
	.summary,
	.summary-text {
		padding: 0;
		list-style: none;
		font-size: 0.91rem;
		line-height: 1.65;
		color: var(--muted);
	}
	.summary li + li {
		margin-top: 0.45rem;
	}
	.read {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: auto;
		padding-top: 0.85rem;
		border-top: 1px solid var(--border);
		font-weight: 700;
		font-size: 0.85rem;
		color: var(--accent-text);
	}
	.arrow {
		transition: transform 180ms ease;
	}
	.project-link:hover .arrow {
		transform: translateX(4px);
	}
</style>
