---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrapper footer-inner">
		<div class="group">
			<p>&copy; {currentYear} Mark McManus</p>
			<span class="sep" aria-hidden="true">&middot;</span>
			<p>Photography by Robert McManus</p>
		</div>
		<nav class="links" aria-label="Footer links">
			<a href="https://ki10games.com" target="_blank" rel="noopener noreferrer">Ki10 Games</a>
			<a href="https://ki10games.com/qa-services" target="_blank" rel="noopener noreferrer">Indie QA Services</a>
			<a href="https://www.linkedin.com/in/mark-mcmanus-b52b11105/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a href="https://github.com/murkmm" target="_blank" rel="noopener noreferrer">GitHub</a>
			<a href="/mark-mcmanus-cv.pdf" target="_blank" rel="noopener noreferrer">CV (PDF)</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		border-top: 1px solid var(--border);
		background: var(--bg);
		color: var(--muted);
		font-size: 0.85rem;
	}
	.footer-inner {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding-block: 2rem;
		align-items: center;
		text-align: center;
	}
	.group {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.25rem;
	}
	.links a {
		color: var(--muted);
		text-decoration: none;
		font-weight: 600;
		transition: color 150ms ease;
	}
	.links a:hover {
		color: var(--accent-text);
		text-decoration: underline;
		text-underline-offset: 4px;
	}
	@media (min-width: 52em) {
		.footer-inner {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}
	}
</style>
