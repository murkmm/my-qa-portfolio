---
interface Props {
	variant?: 'offset' | 'small' | 'thirds';
}

const { variant } = Astro.props;
---

<ul class:list={['grid', { offset: variant === 'offset', small: variant === 'small', thirds: variant === 'thirds' }]}>
	<slot />
</ul>

<style>
	.grid {
		display: grid;
		grid-auto-rows: 1fr;
		gap: 1rem;
		list-style: none;
		padding: 0;
	}

	.grid.small {
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	.grid.small > :global(:last-child:nth-child(odd)) {
		grid-column: 1 / 3;
	}

	/* Three equal columns, no stagger. The offset variant leaves a hole when the
	   item count is odd, which is wrong for a section that always shows three. */
	.grid.thirds {
		gap: 1.5rem;
	}

	@media (min-width: 50em) {
		.grid {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}

		.grid.thirds {
			grid-template-columns: repeat(3, 1fr);
			gap: 2rem;
		}

		.grid.offset {
			--row-offset: 7.5rem;
			padding-bottom: var(--row-offset);
		}

		/* Shift second item in each row vertically to create staggered effect. */
		.grid.offset > :global(:nth-child(even)) { /* CHANGED from 'odd' to 'even' */
			transform: translateY(var(--row-offset));
		}

		.grid.offset > :global(:last-child:nth-child(odd)) {
			grid-column: 2 / 3;
			transform: none;
		}

		.grid.small {
			display: flex;
			flex-wrap: wrap;
			justify-content: center;
			gap: 2rem;
		}

		.grid.small > :global(*) {
			flex-basis: 20rem;
		}
	}
</style>