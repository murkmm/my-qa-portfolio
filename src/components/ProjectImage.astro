---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: string;
	alt: string;
	eager?: boolean;
	sizes?: string;
}
const {
	src,
	alt,
	eager = false,
	sizes = '(min-width: 80em) 420px, (min-width: 50em) 33vw, 100vw',
} = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>(
	'../../public/assets/*.{png,jpg,jpeg,JPG,webp}',
	{ eager: true },
);
const image = images[`../../public${src}`]?.default;
---

{
	image ? (
		<Image
			src={image}
			alt={alt}
			widths={[360, 640, 960]}
			sizes={sizes}
			loading={eager ? 'eager' : 'lazy'}
		/>
	) : (
		<img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} />
	)
}
<style>
	img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
